APP_NAME="ReGenesis AI"
DEBUG=false
ENVIRONMENT=development
SEED_DEMO_DATA=true
DEMO_MODE=true
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
USE_SQLITE=true
SQLITE_DB_PATH=regenesis_isef_demo.db
POSTGRES_USER=regenesis
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=regenesis_ai
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
MAX_UPLOAD_SIZE=52428800
GEMINI_API_KEY=
OPENAI_API_KEY=

# Local free AI model (install Ollama, then run: ollama pull qwen3:4b)
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=120

# Local vision model for waste-photo analysis
OLLAMA_VISION_MODEL=qwen2.5vl:3b

# Live web search (requires a provider key; never commit real keys)
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
WEB_SEARCH_TIMEOUT_SECONDS=12
